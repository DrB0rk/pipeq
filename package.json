{
  "name": "pipeq",
  "version": "0.1.0",
  "description": "A quality-first realtime PipeWire parametric EQ TUI for Linux.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrB0rk/pipeq.git"
  },
  "bugs": {
    "url": "https://github.com/DrB0rk/pipeq/issues"
  },
  "homepage": "https://github.com/DrB0rk/pipeq#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pipeq": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
